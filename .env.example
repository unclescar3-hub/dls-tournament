# Environment variables (copy to .env)

DATABASE_URL=postgresql://user:password@localhost:5432/dls_tournament
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this

# Email (SMTP) for NextAuth Email provider or SendGrid SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Paystack (optional)
PAYSTACK_SECRET_KEY=

# SendGrid (optional if using SendGrid API)
SENDGRID_API_KEY=

# App URL
APP_URL=http://localhost:3000
